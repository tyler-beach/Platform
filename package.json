    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test test/*.test.cjs docs/javascripts/demo-explorer.test.cjs docs/javascripts/diagram-viewer.test.cjs docs/javascripts/site-experience.test.cjs",
    "predev": "node scripts/generate-doc-index.mjs"
  },
