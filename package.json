  "dependencies": {
    "dompurify": "^3.4.17",
    "lucide-react": "^0.468.0",
    "mermaid": "^12.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "rehype-raw": "^7.0.0",
