  "description": "An evidence-first platform for detecting inconsistencies between architectural decisions, technical specifications, and implementation changes.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
